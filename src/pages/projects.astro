---
// LAYOUTS
import Layout from '../layouts/Layout.astro';
import Header from '../layouts/Header.astro';
import Footer from '../layouts/Footer.astro';

// COMPONENTS
import Banner from '@/components/Banner.astro';
import ListProjects from '@/components/ListProjects.astro';

// CSS
import 'photoswipe/style.css';
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap-icons/font/bootstrap-icons.min.css";
---

<Layout title="Welcome to Astro.">
	<Header />
    	<Banner titleBanner='PROYECTOS' imgBanner="banner-img-1"/>
		<ListProjects title='title--2' subTitle='sub-title--2' intoTitle='into-title--2' backgroundColor="background-projects--2" borderCategory="border-category--2"/>

	<Footer />
	<script src="https://unpkg.com/isotope-layout@3/dist/isotope.pkgd.min.js"></script>
</Layout>
<script>
	// Astro will bundle and process this automatically
	import 'bootstrap/dist/js/bootstrap.bundle.min.js'
</script>
